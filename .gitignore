# Workspace builds and generated application packages are reproducible outputs.
target/
/benchmarks/artifacts/
**/*.rs.bk
*.app/
*.dmg
*.dSYM/
*.profraw
*.profdata
*.memgraph
*.heap
*.sample
*.spindump
*.trace/
*.crash
.cargo-ok

# Package-manager caches and frontend outputs are never source inputs.
/node_modules/
/.pnpm-store/
/dist/

# Automation bytecode and local diagnostics do not belong in source history.
__pycache__/
*.py[cod]
*.log

# Local environment overrides stay private; reviewed examples remain eligible.
.env
.env.*
!.env.example
!.env.sample
/.local/
.secrets/

# Cargo credentials stay local; build configuration and lockfiles remain visible.
**/.cargo/credentials
**/.cargo/credentials.toml
# Separate machine-specific overrides from the shared build configuration.
/.cargo/config.local.toml

# Private signing material and SSH identities must be provisioned outside Git.
*.p12
*.pfx
*.p8
*.key
*.pem
*.mobileprovision
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Local agent rules, sessions, and editor settings stay outside product history.
/.agents/
/.codex/
/.trellis/
/AGENTS.md
/CLAUDE.md
/.cursor/
/.windsurf/
/.claude/

# Operating-system metadata and per-user IDE state are not build inputs.
.DS_Store
.AppleDouble/
.idea/
.vscode/
*.swp
*.swo
*~
